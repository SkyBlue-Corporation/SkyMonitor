# Copiez ce fichier en .env et renseignez de vraies valeurs.
# Ne jamais committer le fichier .env (déjà exclu par .gitignore).

# --- Flask ---
SECRET_KEY=change-me-to-a-random-64-char-hex-string
FLASK_ENV=production

# --- Authentification app (login.html) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Alternative: fournir directement un hash (werkzeug generate_password_hash)
# au lieu de ADMIN_PASSWORD :
# ADMIN_PASSWORD_HASH=

# --- InfluxDB ---
INFLUXDB_ORG=monitoring-org
INFLUXDB_BUCKET=monitoring-data
INFLUXDB_TOKEN=change-me
INFLUXDB_ADMIN_PASSWORD=change-me

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Telegram (optionnel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Réseau ---
NETWORK_CIDR=10.236.155.0/24
# Origines autorisées pour Socket.IO si le frontend est servi depuis un autre
# domaine (liste séparée par des virgules). Laisser vide = same-origin only.
SOCKETIO_CORS_ORIGINS=
